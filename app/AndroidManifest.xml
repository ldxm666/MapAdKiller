<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.ldxm666.mapadkiller"
    android:versionCode="23060"
    android:versionName="2.3.6">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- 版本检查：去 GitHub Releases 拉最新版本号（多源回退，失败不打扰） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        抓取结果通知（v2.3.0）：抓取跑在高德进程里，完成时设置页一定不在前台，
        通知栏是唯一还能看见「抓完了 / 抓了多少项」的通道。
        Android 13+ 不声明这条 → requestPermissions() 直接 DENIED、notify() 被系统静默丢弃，
        用户看到的就是「抓完什么都不提示」。运行时申请在 MainActivity#ensureNotifyPermission()。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 包可见性：设置页要读三家地图的版本号/作用域做状态自检 -->
    <queries>
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.tencent.map" />
    </queries>

    <application
        android:name="io.github.ldxm666.mapclean.App"
        android:extractNativeLibs="false"
        android:label="MapAdKiller"
        android:description="@string/description"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
            设置页（v2.0.0 起是**左右滑动分页**：百度地图 / 高德地图 / 其他）。
            CATEGORY_INFO 供 LSPosed 管理器解析入口；显式组件名供 adb 拉起：
              adb shell am start -n io.github.ldxm666.mapclean/.MainActivity
        -->
        <activity
            android:name="io.github.ldxm666.mapclean.MainActivity"
            android:exported="true"
            android:label="MapAdKiller">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 桌面入口：开/关由 App.setHideIcon() 通过 setComponentEnabledSetting 切换 -->
        <activity-alias
            android:name=".DesktopAlias"
            android:targetActivity="io.github.ldxm666.mapclean.MainActivity"
            android:exported="true"
            android:label="MapAdKiller"
            android:icon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 快捷设置磁贴（来自 MapAdKiller v1.1.0） -->
        <service
            android:name="io.github.ldxm666.mapadkiller.SettingsTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="MapAdKiller"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="io.github.ldxm666.mapadkiller.LearnedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ldxm666.mapadkiller.LEARNED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="io.github.ldxm666.mapadkiller.LearnedProvider"
            android:authorities="io.github.ldxm666.mapadkiller.learned"
            android:exported="true" />

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.ldxm666.mapadkiller.XposedService"
            android:exported="true" />

        <!--
            百度侧：目标进程里的 hook 通过显式广播回报钩子状态与规则命中结果。
            接收方只把文本写进本地存储并刷新设置页，且校验 App 侧生成的 token。
        -->
        <!--
            高德侧：抓取云数据的状态回报（抓完 / 失败 / 文件数）。
            宿主进程写不了 RemotePreferences（hook 侧只读实现），只能靠这条显式广播把
            「到底抓到没」告诉设置页 —— 不做这一步，首页永远显示「未抓取」，用户就会
            以为抓取一直失败。
        -->
        <receiver
            android:name="io.github.ldxm666.mapadkiller.CaptureReportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ldxm666.mapadkiller.CAPTURE_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="io.github.ldxm666.bmapclean.ReportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ldxm666.bmapclean.REPORT" />
            </intent-filter>
        </receiver>

        <!--
            腾讯侧：同上。除了钩子状态，这条通道还承载「学到的首页工具目录」——
            腾讯的工具列表由服务端下发，安装包里没有静态目录，只能从真实进程里学回来。
        -->
        <receiver
            android:name="io.github.ldxm666.tmapclean.ReportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ldxm666.tmapclean.REPORT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
